{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 180,
  "tabWidth": 4,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "ignorePatterns": [],
  "overrides": [
    {
      "files": ["*.json", "*.yml", "*.yaml", "*.css"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
